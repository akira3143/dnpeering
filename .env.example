# === Required Secrets (Must be set before deployment) ===

# JWT signing secret - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_JWT_SECRET=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID for admin notifications
TELEGRAM_CHAT_ID=

# === Admin Account (Required for admin login) ===
# Generate hash: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('SALT='+s);console.log('HASH='+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# === Probe Authentication (Required for remote PoP port reporting) ===
# Generate with: openssl rand -hex 32
PROBE_AUTH_TOKEN=

# === Optional Configuration ===

# Server port (default: 4242 in dev, 80 in Docker)
# PORT=4242

# Trust reverse proxy X-Forwarded-For header (set to 'true' behind Nginx/Cloudflare)
# TRUST_PROXY=true

# Registry sync interval in hours (default: 4, range: 3-6)
# REGISTRY_SYNC_INTERVAL_HOURS=4

# === Looking Glass (bird-lg-go Proxy Configuration) ===
# JSON mapping of node IDs to bird-lgproxy URLs
# Local node (e.g. jp07) can point to http://127.0.0.1:5000, remote nodes to their internal DN42 IPs
LG_NODE_ENDPOINTS={"jp07":"http://127.0.0.1:5000","us01":"http://172.20.14.2:5000","de02":"http://172.20.14.3:5000"}
LG_DEFAULT_NODE=jp07

# Optional bird-lgproxy access token (if configured with -token on nodes)
# LG_PROXY_TOKEN=your_secure_proxy_token
