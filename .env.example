# ==============================================================================
# 🌐 AkiLab DN42 Peering Portal - 环境变量配置文件模板 (.env.example)
#
# 💡 使用说明：
# 1. 复制本文件为 .env 即可生效：cp .env.example .env
# 2. 生产环境中，修改本文件后需执行 `dnp r` 重启服务生效。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 管理员身份认证与 JWT 密钥 (必需)
# ------------------------------------------------------------------------------

# JWT 登录鉴权密钥 (高强度随机 64 字节十六进制字符串)
# 生成指令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_JWT_SECRET=

# 管理员密码哈希与加盐 (通过 scrypt 算法加密)
# 生成指令: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('ADMIN_PASSWORD_SALT='+s);console.log('ADMIN_PASSWORD_HASH='+c.scryptSync('你的管理员密码',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=


# ------------------------------------------------------------------------------
# 2. Telegram Bot 审计与申请通知 (可选但强烈推荐)
# ------------------------------------------------------------------------------

# Telegram 机器人 Token (从 @BotFather 获取)
TELEGRAM_BOT_TOKEN=

# 接收申请通知的管理员/频道 Chat ID (从 @userinfobot 获取)
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------------------------
# 3. 官方原生 bird-lgproxy 探针安全选项 (可选)
# ------------------------------------------------------------------------------

# bird-lgproxy 访问鉴权 Token (如果在探针端开启了 -token 参数，在此填写对应 Token)
# 留空表示无密码直接 HTTP 通信
# LG_PROXY_TOKEN=your_secure_proxy_token

# 默认选中的 Looking Glass 诊断源节点代号 (默认: jp07)
# LG_DEFAULT_NODE=jp07


# ------------------------------------------------------------------------------
# 4. 服务端网络与高级选项 (可选)
# ------------------------------------------------------------------------------

# 门户服务监听端口 (默认: 4242)
# PORT=4242

# 反向代理信任 (若置于 Nginx / Caddy / Cloudflare 等反代之后，设为 true 以正确获取真实客户端 IP)
# TRUST_PROXY=true

# 远程配置源 URL (可选：指定外部 HTTPS YAML 文件地址实现配置跨服集中下发)
# REMOTE_CONFIG_URL=https://raw.githubusercontent.com/yourname/configs/main/portal.config.yaml

# DN42 官方 Registry 注册表同步周期 (单位: 小时，默认: 4，建议范围: 3~6)
# REGISTRY_SYNC_INTERVAL_HOURS=4

